# ---- Python 标准模板 ----

# 字节码 / 编译产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 构建 / 打包
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# 安装 / 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# 类型检查与 lint 缓存
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/

# Jupyter
.ipynb_checkpoints/

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境变量
.env
.env.*
!.env.example

# ---- 本项目专用 ----

# 报告与运行产物（可能含用户真实参数，禁入库）
out/
reports/
runs/

# M3 fixture 产物：内容由 tools/gen_fixtures.py 重算，不入仓；
# 入仓的是生成器 + 清单（fixtures/manifest.json）。
fixtures/*.json
!fixtures/manifest.json

# 生成图片一律不入仓：M5 栅格化仿真产物、fixture 渲染图、临时截图
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff

# M5 oracle 回读结果
oracle-report.json

# 发布产物
release/
*.zip
*.tar.gz

# 临时工作目录
.tmp/
.tmp_*/
tmp/

# 二次迭代交接目录（诊断报告 / 迭代路线 / 提示词 / 执行记录）与临时草稿区：
# 属本地产物、不入库。与 tools/check_desensitized.py 的 SKIP_DIRS **成对维护**——
# 只 ignore 不 SKIP 会让脱敏门去扫它们（做一次诊断就打红门），
# 只 SKIP 不 ignore 会把交接物推上远端。
update/
.scratch/

# 本机工具状态（agent/skill 运行时产物，不是仓库内容）
.mimosa/
.claude/
.zcode/
